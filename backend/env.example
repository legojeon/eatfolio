# ========================================
# Eatfolio Backend Environment Variables
# ========================================
# 이 파일을 .env로 복사하고 실제 값들을 입력하세요
# cp env.example .env

# ========================================
# 필수 환경변수 (Required)
# ========================================

# Firebase Admin SDK 인증 정보 (Base64 인코딩된 JSON)
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 생성된 JSON 파일을 base64로 인코딩하여 입력
FIREBASE_CREDENTIALS_B64="your_base64_encoded_firebase_credentials_here"

# Google Gemini API 키
# https://makersuite.google.com/app/apikey 에서 발급
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# AI 모델 API URL (YOLOv3 + ResNet 기반)
# 음식 분류 및 양 추정을 위한 전용 AI 모델 서버 주소
MODEL_API_URL="http://localhost:8001"  # 또는 실제 AI 모델 서버 URL

